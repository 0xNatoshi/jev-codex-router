{
  "version": 1,
  "providers": [
    {
      "id": "cerebras",
      "displayName": "Cerebras",
      "kind": "openai-compatible",
      "ownedBy": "cerebras",
      "baseUrl": "https://api.cerebras.ai/v1",
      "baseUrlEnv": "CEREBRAS_API_BASE_URL",
      "credential": {
        "environment": [
          "CEREBRAS_API_KEY"
        ],
        "file": "cerebras-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-cerebras"
        ],
        "prompt": "Cerebras API key"
      }
    }
  ]
}

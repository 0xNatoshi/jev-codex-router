{
  "version": 1,
  "providers": [
    {
      "id": "mistral",
      "displayName": "Mistral AI",
      "kind": "openai-compatible",
      "ownedBy": "mistral",
      "baseUrl": "https://api.mistral.ai/v1",
      "baseUrlEnv": "MISTRAL_API_BASE_URL",
      "credential": {
        "environment": [
          "MISTRAL_API_KEY"
        ],
        "file": "mistral-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-mistral"
        ],
        "prompt": "Mistral AI API key"
      }
    }
  ]
}

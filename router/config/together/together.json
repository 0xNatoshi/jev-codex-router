{
  "version": 1,
  "providers": [
    {
      "id": "together",
      "displayName": "Together AI",
      "kind": "openai-compatible",
      "ownedBy": "together",
      "baseUrl": "https://api.together.xyz/v1",
      "baseUrlEnv": "TOGETHER_API_BASE_URL",
      "credential": {
        "environment": [
          "TOGETHER_API_KEY"
        ],
        "file": "together-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-together"
        ],
        "prompt": "Together AI API key"
      }
    }
  ]
}
